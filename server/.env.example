MONGO_URI=mongodb://localhost:27017/payportal
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
# Optional: only send SMS codes to these country codes (comma separated). Empty = all.
SMS_ALLOWED_COUNTRIES=
# Optional: country code for phone numbers typed without "+". Default 1.
DEFAULT_COUNTRY_CODE=1
# Optional: set to 1 when deployed behind a proxy/host so IP rate limits work.
TRUST_PROXY=
