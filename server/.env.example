MONGO_URI=mongodb://localhost:27017/payportal
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
PORT=4000

# Optional: only send SMS codes to these country codes (comma separated). Empty = all.
SMS_ALLOWED_COUNTRIES=

# Optional: country code for phone numbers typed without "+". Default 1.
DEFAULT_COUNTRY_CODE=1

# Optional: set to 1 when deployed behind a proxy/host so IP rate limits work.
TRUST_PROXY=

# SMS provider (Twilio). Leave blank to print codes to console instead.
# Get free Twilio account at https://www.twilio.com/console/phone-numbers/incoming
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email provider (optional, for production send-code emails).
# Currently: console logging only. Integrate Resend, Postmark, SendGrid, or Mailgun.
EMAIL_PROVIDER=
